      <table>
        <view>
          <datasources>
            <datasource caption='nearest_airport_airtanker_bases_to_fires_final' name='federated.1vssqu210cvtis133cpf70f7h1zf' />
            <datasource caption='National_GACC_Final_20250113' name='federated.0t57buf02cu4ga0zkbn8f01j3y9s' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0t57buf02cu4ga0zkbn8f01j3y9s'>
            <column caption='GACC Name' datatype='string' name='[GACCName]' role='dimension' type='nominal' />
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column-instance column='[Geometry]' derivation='Collect' name='[clct:Geometry:nk]' pivot='key' type='nominal' />
            <column-instance column='[GACCName]' derivation='None' name='[none:GACCName:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vssqu210cvtis133cpf70f7h1zf'>
            <column caption='Wildfire Location' datatype='spatial' name='[Calculation_2701033904218406912]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MAKEPOINT([fire_lat],[fire_lon])' />
            </column>
            <column caption='Airport Location' datatype='spatial' name='[Calculation_2701033904218558465]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MAKEPOINT([latitude_deg],[longitude_deg])' />
            </column>
            <column caption='Fire to Base Line' datatype='spatial' name='[Calculation_2701033904237993989]' role='measure' type='nominal'>
